{
  "name": "aicop",
  "displayName": "AICop — AI Code Scanner",
  "description": "Detects security holes, AI-generated anti-patterns, and tech debt in JS/TS code",
  "version": "1.0.0",
  "publisher": "aicop",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Other"],
  "keywords": ["security", "ai", "linter", "ai-coding", "typescript"],
  "repository": {
    "type": "git",
    "url": "https://github.com/CayMac97/Vibecop"
  },
  "bugs": { "url": "https://github.com/CayMac97/Vibecop/issues" },
  "homepage": "https://aicop.net",
  "galleryBanner": { "color": "#0a0a0a", "theme": "dark" },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aicop.scanFile",
        "title": "AICop: Scan Current File"
      },
      {
        "command": "aicop.scanWorkspace",
        "title": "AICop: Scan Entire Workspace"
      },
      {
        "command": "aicop.clearDiagnostics",
        "title": "AICop: Clear All Diagnostics"
      },
      {
        "command": "aicop.generateFixPrompt",
        "title": "AICop: Generate AI Fix Prompt"
      },
      {
        "command": "aicop.saveBaseline",
        "title": "AICop: Save Current Score as Baseline"
      }
    ],
    "configuration": {
      "title": "AICop",
      "properties": {
        "aicop.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AICop diagnostics"
        },
        "aicop.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files on save"
        },
        "aicop.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files when opened"
        },
        "aicop.minSeverity": {
          "type": "string",
          "enum": ["info", "warn", "error"],
          "default": "warn",
          "description": "Minimum severity level to show"
        },
        "aicop.showAIScore": {
          "type": "boolean",
          "default": true,
          "description": "Show AIScore™ in the status bar"
        },
        "aicop.excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules/**", "dist/**", "build/**"],
          "description": "Glob patterns to exclude from scanning"
        },
        "aicop.ruleOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["off", "info", "warn", "error"]
          },
          "default": {},
          "description": "Override severity for individual rules. Key = rule ID (e.g. \"security/missing-rate-limit\"), value = \"off\" | \"info\" | \"warn\" | \"error\"."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
