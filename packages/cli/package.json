{
  "name": "aicop",
  "version": "1.2.0",
  "description": "Next-gen zero-config AST linter & scanner finding severe logic, AI, and security issues.",
  "keywords": [
    "security",
    "linter",
    "ai",
    "ai-coding",
    "code-quality",
    "static-analysis"
  ],
  "bin": {
    "aicop": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CayMac97/aicop.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typescript-eslint/typescript-estree": "^7.18.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^13.0.6",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "picomatch": "^2.3.2",
    "simple-git": "^3.25.0",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
