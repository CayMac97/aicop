{
  "name": "aicop",
  "version": "1.0.4",
  "description": "CLI security and quality scanner for AI-generated code",
  "keywords": [
    "security",
    "linter",
    "ai",
    "ai-coding",
    "code-quality",
    "static-analysis"
  ],
  "bin": {
    "aicop": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "@typescript-eslint/typescript-estree": "^7.18.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "simple-git": "^3.25.0",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
